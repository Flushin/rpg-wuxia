{
  "name": "mistpeak",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:items && npm run check:epic && npm run check:auto && npm run check:skills && npm run check:i18n && npm run check:m5 && npm run check:quests && npm run check:respawn && npm run check:balance && npm run check:m9 && npm run check:m10 && npm run check:m11 && npm run check:dungeon && npm run check:bots && npm run check:party && npm run check:arena && npm run check:trial && npm run check:teleport && npm run check:worldmap && npm run check:wiki && npm run check:novidades",
    "maps": "node tools/gen-maps.mjs",
    "check:epic": "esbuild tools/epic-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/epic-check.mjs && node /tmp/epic-check.mjs",
    "check:items": "esbuild tools/items-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/items-check.mjs && node /tmp/items-check.mjs",
    "check:auto": "esbuild tools/auto-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/auto-check.mjs && node /tmp/auto-check.mjs",
    "check:skills": "esbuild tools/skills-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/skills-check.mjs && node /tmp/skills-check.mjs",
    "sim:balance": "esbuild tools/balance-sim.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/balance-sim.mjs && node /tmp/balance-sim.mjs",
    "sim:ult": "esbuild tools/ult-sim.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/ult-sim.mjs && node /tmp/ult-sim.mjs",
    "balance": "esbuild tools/balance.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/balance.mjs && node /tmp/balance.mjs",
    "check:balance": "esbuild tools/balance-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/balance-check.mjs && node /tmp/balance-check.mjs",
    "check:i18n": "esbuild tools/i18n-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/i18n-check.mjs && node /tmp/i18n-check.mjs",
    "check:m5": "esbuild tools/m5-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/m5-check.mjs && node /tmp/m5-check.mjs",
    "check:layout": "node tools/layout-check.mjs",
    "chaos": "node tools/chaos-bot.mjs",
    "check:quests": "esbuild tools/quests-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/quests-check.mjs && node /tmp/quests-check.mjs",
    "check:respawn": "esbuild tools/respawn-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/respawn-check.mjs && node /tmp/respawn-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "android:prepare": "npm run build && (test -d android || npx cap add android) && node tools/android-version.mjs && npx capacitor-assets generate --android && npx cap sync android && node tools/android-trim-audio.mjs",
    "android:apk": "npm run android:prepare && cd android && ./gradlew assembleDebug",
    "check:wiki": "esbuild tools/wiki-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/wiki-check.mjs && node /tmp/wiki-check.mjs",
    "check:novidades": "esbuild tools/novidades-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/novidades-check.mjs && node /tmp/novidades-check.mjs",
    "novidades:apk": "esbuild tools/novidades-apk.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/novidades-apk.mjs && node /tmp/novidades-apk.mjs",
    "novidades:loja": "esbuild tools/novidades-loja.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/novidades-loja.mjs && node /tmp/novidades-loja.mjs",
    "check:bots": "esbuild tools/bots-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/bots-check.mjs && node /tmp/bots-check.mjs",
    "check:party": "esbuild tools/party-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/party-check.mjs && node /tmp/party-check.mjs",
    "check:arena": "esbuild tools/arena-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/arena-check.mjs && node /tmp/arena-check.mjs",
    "check:dungeon": "esbuild tools/dungeon-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/dungeon-check.mjs && node /tmp/dungeon-check.mjs",
    "check:worldmap": "esbuild tools/worldmap-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/worldmap-check.mjs && node /tmp/worldmap-check.mjs",
    "check:trial": "esbuild tools/trial-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/trial-check.mjs && node /tmp/trial-check.mjs",
    "check:teleport": "esbuild tools/teleport-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/teleport-check.mjs && node /tmp/teleport-check.mjs",
    "check:m9": "esbuild tools/m9-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/m9-check.mjs && node /tmp/m9-check.mjs",
    "check:m10": "esbuild tools/m10-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/m10-check.mjs && node /tmp/m10-check.mjs",
    "check:m11": "esbuild tools/m11-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/m11-check.mjs && node /tmp/m11-check.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/roboto": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "esbuild": "^0.21.5",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
