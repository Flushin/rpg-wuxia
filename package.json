{
  "name": "mistpeak",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "npm run check:items && npm run check:auto && npm run check:skills && npm run check:i18n && npm run check:m5 && npm run check:quests && npm run check:respawn && npm run check:balance && npm run check:m9 && npm run check:m0 && npm run check:headless",
    "maps": "node tools/gen-maps.mjs",
    "check:items": "esbuild tools/items-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/items-check.mjs && node /tmp/items-check.mjs",
    "check:auto": "esbuild tools/auto-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/auto-check.mjs && node /tmp/auto-check.mjs",
    "check:skills": "esbuild tools/skills-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/skills-check.mjs && node /tmp/skills-check.mjs",
    "sim:balance": "esbuild tools/balance-sim.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/balance-sim.mjs && node /tmp/balance-sim.mjs",
    "balance": "esbuild tools/balance.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/balance.mjs && node /tmp/balance.mjs",
    "check:balance": "esbuild tools/balance-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/balance-check.mjs && node /tmp/balance-check.mjs",
    "check:i18n": "esbuild tools/i18n-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/i18n-check.mjs && node /tmp/i18n-check.mjs",
    "check:m5": "esbuild tools/m5-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/m5-check.mjs && node /tmp/m5-check.mjs",
    "check:layout": "node tools/layout-check.mjs",
    "chaos": "node tools/chaos-bot.mjs",
    "check:quests": "esbuild tools/quests-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/quests-check.mjs && node /tmp/quests-check.mjs",
    "check:respawn": "esbuild tools/respawn-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/respawn-check.mjs && node /tmp/respawn-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "android:prepare": "npm run build && (test -d android || npx cap add android) && node tools/android-version.mjs && npx capacitor-assets generate --android && npx cap sync android && node tools/android-trim-audio.mjs",
    "android:apk": "npm run android:prepare && cd android && ./gradlew assembleDebug",
    "check:m9": "esbuild tools/m9-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/m9-check.mjs && node /tmp/m9-check.mjs",
    "build:headless": "node tools/headless-build.mjs",
    "check:headless": "node tools/headless-check.mjs",
    "golden:headless": "node tools/headless-golden.mjs",
    "check:m0": "esbuild tools/m0-check.ts --bundle --platform=node --format=esm --log-level=error --outfile=/tmp/m0-check.mjs && node /tmp/m0-check.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "idb-keyval": "^6.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.20.5",
    "esbuild": "^0.21.5",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
